{
  "name": "@modo-corre/ui",
  "version": "0.4.1",
  "description": "Componentes shadcn/ui e identidade visual Modo Corre",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "styles.css",
    "tokens.css",
    "README.md",
    "components.json",
    "registry.json",
    "bubble/dist/mc-ui-bubble.js",
    "bubble/dist/mc-ui.css",
    "bubble/dist/bubble-color-tokens.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build:bubble": "npm --prefix bubble install && npm --prefix bubble run build",
    "shadcn:add": "node scripts/shadcn-add.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "shadcn": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
